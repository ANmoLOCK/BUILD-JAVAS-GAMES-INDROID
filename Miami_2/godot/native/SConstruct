#!/usr/bin/env python3
"""Compila o cérebro Miami 3D como GDExtension (Godot 4.3)."""
import os
from pathlib import Path

env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src"])
env.Append(CPPDEFINES=["MIAMI_BRAIN_GDEXTENSION"])

sources = Glob("src/*.cpp")

doc_data = Path("src/doc_classes")
if doc_data.exists():
    try:
        doc_data_gen = env.GodotCPPDocData("src/gen/doc_data.gen.cpp", source=Glob("src/doc_classes/*.xml"))
        sources.append(doc_data_gen)
    except AttributeError:
        pass

lib_name = "miami_brain"
bin_folder = "bin"
target = f"{bin_folder}/lib{lib_name}{env['suffix']}{env['SHLIBSUFFIX']}"

library = env.SharedLibrary(target=target, source=sources)
Default(library)

# Copia também para o projeto Godot
def copy_to_project(target, source, env):
    import shutil
    dest_dir = Path("../miami3d/bin")
    dest_dir.mkdir(parents=True, exist_ok=True)
    for t in target:
        shutil.copy2(t.get_path(), dest_dir / Path(t.get_path()).name)
        print("copied", t.get_path(), "->", dest_dir)

env.AddPostAction(library, copy_to_project)
