[configuration]
entry_symbol = "miami_brain_library_init"
compatibility_minimum = "4.3"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://bin/libmiami_brain.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libmiami_brain.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libmiami_brain.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libmiami_brain.windows.template_release.x86_64.dll"
macos.debug = "res://bin/libmiami_brain.macos.template_debug.framework"
macos.release = "res://bin/libmiami_brain.macos.template_release.framework"
android.debug.arm64 = "res://bin/libmiami_brain.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/libmiami_brain.android.template_release.arm64.so"
