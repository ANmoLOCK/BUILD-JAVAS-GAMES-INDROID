{
  "timeScaleSecondsPerMinute": 1.0,
  "arrestAtCrime": 80,
  "bail": { "base": 200, "min": 40, "max": 500, "halfAfterMinutes": 120 },
  "stats": [
    { "id": "hunger", "name": "@stat.hunger", "kind": "need", "initial": 20, "perHour": 2, "higherIsWorse": true,
      "thresholds": [20, 35, 55, 70, 100],
      "warnings": [ { "at": 70, "text": "@warn.hunger.1" }, { "at": 90, "text": "@warn.hunger.2" } ],
      "collapse": { "at": 100, "text": "@warn.hunger.collapse", "do": [ { "stat": { "hunger": -60, "health": -20 } }, { "advanceTime": 60 } ] } },
    { "id": "sleep", "name": "@stat.sleep", "kind": "need", "initial": 20, "perHour": 3, "higherIsWorse": true,
      "thresholds": [20, 40, 60, 80, 100],
      "warnings": [ { "at": 70, "text": "@warn.sleep.1" }, { "at": 90, "text": "@warn.sleep.2" } ],
      "collapse": { "at": 100, "text": "@warn.sleep.collapse", "do": [ { "stat": { "sleep": -50 } }, { "advanceTime": 240 } ] } },
    { "id": "hygiene", "name": "@stat.hygiene", "kind": "need", "initial": 80, "perHour": -1,
      "thresholds": [20, 40, 60, 80, 100],
      "warnings": [ { "at": 30, "text": "@warn.hygiene.1" }, { "at": 10, "text": "@warn.hygiene.2" } ],
      "collapse": { "at": 0, "text": "@warn.hygiene.collapse", "do": [ { "stat": { "hygiene": 60, "self_esteem": -10 } }, { "teleport": { "location": "player_apartment", "spawn": "bathroom" } } ] } },
    { "id": "bladder", "name": "@stat.bladder", "kind": "need", "initial": 10, "perHour": 1, "higherIsWorse": true,
      "thresholds": [25, 50, 75, 90, 100],
      "warnings": [ { "at": 75, "text": "@warn.bladder.1" }, { "at": 90, "text": "@warn.bladder.2" } ],
      "collapse": { "at": 100, "text": "@warn.bladder.collapse", "do": [ { "stat": { "bladder": -100, "hygiene": -40, "self_esteem": -15 } } ] } },
    { "id": "fitness", "name": "@stat.fitness", "kind": "skill", "initial": 10, "thresholds": [20, 40, 60, 80, 100] },
    { "id": "culture", "name": "@stat.culture", "kind": "skill", "initial": 10, "thresholds": [20, 40, 60, 80, 100] },
    { "id": "charisma", "name": "@stat.charisma", "kind": "skill", "initial": 10, "thresholds": [20, 40, 60, 80, 100] },
    { "id": "crime", "name": "@stat.crime", "kind": "reputation", "initial": 0, "higherIsWorse": true, "thresholds": [20, 40, 60, 80, 100] },
    { "id": "kindness", "name": "@stat.kindness", "kind": "reputation", "initial": 10, "thresholds": [20, 40, 60, 80, 100] },
    { "id": "dance", "name": "@stat.dance", "kind": "skill", "initial": 0, "thresholds": [20, 40, 60, 80, 100] },
    { "id": "craziness", "name": "@stat.craziness", "kind": "state", "initial": 0, "perHour": -5, "floor": 0, "thresholds": [20, 40, 60, 80, 100] },
    { "id": "sex_appeal", "name": "@stat.sex_appeal", "kind": "skill", "initial": 10, "thresholds": [20, 40, 60, 80, 100] },
    { "id": "mood", "name": "@stat.mood", "kind": "derived", "initial": 60, "thresholds": [20, 40, 60, 80, 100],
      "derivedFrom": "avg(inv(hunger), inv(sleep), hygiene, inv(bladder))" },
    { "id": "social", "name": "@stat.social", "kind": "derived", "initial": 0, "thresholds": [20, 40, 60, 80, 100],
      "derivedFrom": "min(100, friends_level2 * 10)" },
    { "id": "health", "name": "@stat.health", "kind": "state", "initial": 80, "perHour": 1, "thresholds": [20, 40, 60, 80, 100] },
    { "id": "self_esteem", "name": "@stat.self_esteem", "kind": "state", "initial": 50, "thresholds": [20, 40, 60, 80, 100] }
  ]
}
